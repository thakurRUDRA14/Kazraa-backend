// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// USER
enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

// PRODUCT
enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ImageType {
  FRONT
  BACK
  SIDE
  NECK
  ZOOM
  GALLERY
}

// ATTRIBUTE
enum AttributeType {
  TEXT
  TEXTAREA
  NUMBER
  BOOLEAN
  DATE
  URL
  COLOR
  SELECT
  MULTI_SELECT
}

// CART
enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
}

// ORDER
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  CANCELLED
}

// PAYMENT
enum PaymentMethod {
  COD
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReturnType {
  CUSTOMER_RETURN
  RTO
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  PICKED_UP
  RECEIVED
  COMPLETED
}

// REVIEW
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// BANNERS
enum BannerStatus {
  ACTIVE
  INACTIVE
}

// AUDIT
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PUBLISH
  ARCHIVE
}

model Media {
  id String @id @default(cuid())

  url String

  mimeType String?

  size Int?

  width Int?

  height Int?

  altText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productImages ProductImage[]

  bannerImages       Banner[] @relation("BannerImage")
  bannerMobileImages Banner[] @relation("BannerMobileImage")

  storeLogo    StoreSetting[] @relation("StoreLogo")
  storeFavicon StoreSetting[] @relation("StoreFavicon")
  marketplaces Marketplace[]
  reviewImages ReviewImage[]
}

model Marketplace {
  id String @id @default(cuid())

  name String

  slug String @unique

  logoId String?

  logo Media? @relation(fields: [logoId], references: [id])

  isActive Boolean @default(true)

  links ProductLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreSetting {
  id String @id @default(cuid())

  storeName String
  logoId    String?

  logo Media? @relation("StoreLogo", fields: [logoId], references: [id])

  faviconId String?

  favicon      Media?  @relation("StoreFavicon", fields: [faviconId], references: [id])
  supportEmail String?
  supportPhone String?

  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?

  address   String?
  gstNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String @id @default(uuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// USER
model User {
  id String @id @default(cuid())

  firstName String?
  lastName  String?

  email String @unique
  phone String @unique

  password String

  avatar String?

  role   UserRole   @default(CUSTOMER)
  status UserStatus @default(ACTIVE)

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  lastLoginAt DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  resetToken       String?
  resetTokenExpiry DateTime?
  refreshTokens    RefreshToken[]

  addresses Address[]
  carts     Cart[]
  orders    Order[]
  reviews   Review[]
  auditLogs AuditLog[]

  defaultAddressId String?  @unique
  defaultAddress   Address? @relation("DefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
}

// ADDRESS
model Address {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultForUser User? @relation("DefaultAddress")

  fullName String
  phone    String

  addressLine1 String
  addressLine2 String?

  landmark String?

  city     String
  district String?

  state   String
  country String @default("India")

  postalCode String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([postalCode])
  @@index([city])
  @@index([state])
}

// CATEGORY
model Category {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?
  imageUrl    String?

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([parentId])
}

// COLLECTION
model Collection {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?

  imageUrl String?

  isActive Boolean @default(true)

  sortOrder Int @default(0)

  products CollectionProduct[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
}

// PRODUCT
model Product {
  id String @id @default(cuid())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  name String
  slug String @unique

  shortDescription String?
  description      String

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?

  status ProductStatus @default(DRAFT)

  images ProductImage[]

  sizes ProductSize[]

  attributes ProductAttribute[]

  reviews Review[]

  marketplaceLinks ProductLink[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  collectionProducts CollectionProduct[]

  @@index([categoryId])
  @@index([slug])
  @@index([status])
}

// COLLECTION PRODUCT
model CollectionProduct {
  collectionId String

  productId String

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@id([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

// PRODUCT IMAGE
model ProductImage {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id])

  type ImageType @default(GALLERY)

  altText String?

  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model SizeType {
  id   String @id @default(cuid())
  name String @unique

  sizes Size[]

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Size {
  id String @id @default(cuid())

  sizeTypeId String
  sizeType   SizeType @relation(fields: [sizeTypeId], references: [id])

  name      String
  shortCode String?

  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  productSizes ProductSize[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sizeTypeId, name])
  @@index([sizeTypeId])
}

// PRODUCT SIZE (SELLABLE SKU)
model ProductSize {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sizeId String
  size   Size   @relation(fields: [sizeId], references: [id])

  sku String @unique

  barcode String? @unique

  mrp Decimal @db.Decimal(10, 2)

  sellingPrice Decimal @db.Decimal(10, 2)

  availableStock Int @default(0)

  weight Decimal? @db.Decimal(8, 2)

  isActive Boolean @default(true)

  cartItems CartItem[]

  orderItems OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([productId, sizeId])
  @@index([productId])
  @@index([sizeId])
  @@index([availableStock])
}

// ATTRIBUTE
model Attribute {
  id String @id @default(cuid())

  name String
  slug String @unique

  type AttributeType

  description String?

  isRequired   Boolean @default(false)
  isFilterable Boolean @default(true)

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  options       AttributeOption[]
  productValues ProductAttribute[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([name])
}

// ATTRIBUTE OPTION
model AttributeOption {
  id String @id @default(cuid())

  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  label String
  value String

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  productValues ProductAttribute[]

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  productAttributeOptions ProductAttributeOption[]

  @@unique([attributeId, value])
  @@index([attributeId])
}

// PRODUCT ATTRIBUTE
model ProductAttribute {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id])

  value String?

  options ProductAttributeOption[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  attributeOption   AttributeOption? @relation(fields: [attributeOptionId], references: [id])
  attributeOptionId String?

  @@unique([productId, attributeId])
}

model ProductAttributeOption {
  productAttributeId String
  optionId           String

  productAttribute ProductAttribute @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)
  option           AttributeOption  @relation(fields: [optionId], references: [id])

  @@id([productAttributeId, optionId])
}

// CART
model Cart {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status CartStatus @default(ACTIVE)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// CART ITEM
model CartItem {
  id String @id @default(cuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productSizeId String
  productSize   ProductSize @relation(fields: [productSizeId], references: [id])

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productSizeId])
  @@index([cartId])
  @@index([productSizeId])
}

// ORDER
model Order {
  id String @id @default(cuid())

  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  shippingAddress OrderAddress?

  status OrderStatus @default(PENDING)

  subtotal Decimal @db.Decimal(10, 2)

  shippingCharge Decimal @default(0) @db.Decimal(10, 2)

  tax Decimal @default(0) @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  notes String?

  items OrderItem[]

  payment Payment?

  returnRequest ReturnRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
}

// ORDER ADDRESS (SNAPSHOT)
model OrderAddress {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  name  String
  phone String

  addressLine1 String
  addressLine2 String?

  landmark String?

  city     String
  district String?

  state   String
  country String @default("India")

  postalCode String

  createdAt DateTime @default(now())
}

// ORDER ITEM
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productSizeId String
  productSize   ProductSize @relation(fields: [productSizeId], references: [id])

  productSnapshot Json

  quantity Int

  mrp Decimal @db.Decimal(10, 2)

  sellingPrice Decimal @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  review    Review?

  @@index([orderId])
  @@index([productSizeId])
}

// PAYMENT
model Payment {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method PaymentMethod

  status PaymentStatus @default(PENDING)

  amount Decimal @db.Decimal(10, 2)

  transactionId String?

  gateway String?

  gatewayResponse Json?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ReturnRequest {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type ReturnType

  status ReturnStatus @default(REQUESTED)

  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([type])
  @@index([status])
}

// REVIEW
model Review {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItemId String?    @unique
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  rating Int

  title String?

  review String?

  images ReviewImage[]

  status ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([status])
}

model ReviewImage {
  reviewId String

  mediaId String

  review Review @relation(fields: [reviewId], references: [id])

  media Media @relation(fields: [mediaId], references: [id])

  sortOrder Int @default(0)

  @@id([reviewId, mediaId])
}

// BANNER
model Banner {
  id String @id @default(cuid())

  title String

  subtitle String?

  imageId String
  image   Media  @relation("BannerImage", fields: [imageId], references: [id])

  mobileImageId String?
  mobileImage   Media?  @relation("BannerMobileImage", fields: [mobileImageId], references: [id])

  redirectUrl String?

  sortOrder Int @default(0)

  status BannerStatus @default(ACTIVE)

  startsAt DateTime?

  endsAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([sortOrder])
}

// PRODUCT LINKS
model ProductLink {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  marketplaceId String

  marketplace Marketplace @relation(fields: [marketplaceId], references: [id])

  url String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, marketplaceId])
  @@index([productId])
}

// AUDIT LOG
model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action AuditAction

  entity String

  entityId String?

  oldData Json?

  newData Json?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
}
